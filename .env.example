# ── Chép thành .env.local để chạy dev, hoặc set trên Vercel cho từng khách ──

# Origin Phê Nâu — API (`/api/py`) và cổng đăng nhập (`/coldbrew/authorize`) đều ở đây.
# KHÔNG cần đặt: production mặc định https://phenau.com, dev mặc định http://localhost:3000
# (frontend Phê Nâu local tự rewrite sang FastAPI :8000). Chỉ đặt khi trỏ môi trường khác,
# và chỉ origin, không kèm path.
# PHENAU_URL=https://phenau.com

# FALLBACK LEGACY: API key của workspace khách, gắn cứng tenant + agent.
# ⚠ KHÔNG có tiền tố NEXT_PUBLIC_: key phải ở lại server. BFF proxy tự gắn vào mỗi
# request. Key nằm trong bundle browser = coi như đã lộ.
PHENAU_API_KEY=

# FALLBACK LEGACY: mật khẩu dùng chung cho cả workspace của khách. CÓ giá trị ⇒ hiện
# form mật khẩu; ĐỂ TRỐNG/XOÁ ⇒ tắt, cookie mật khẩu đã phát hết hiệu lực ngay.
# Không phải hệ tài khoản: không thu hồi được theo từng người, và mọi thao tác ghi
# sổ dưới danh tính của API key. Nhân viên nghỉ việc thì đổi mật khẩu này.
APP_PASSWORD=

# FALLBACK LEGACY: secret ký cookie password. Tối thiểu 32 ký tự.
# Sinh nhanh: openssl rand -base64 32
SESSION_SECRET=

# ── Theo từng khách ──
# Agent duy nhất app này hiển thị (phải khớp deployment; và API key khi còn legacy)
NEXT_PUBLIC_AGENT_ID=
# SDK analytics public do Phê Nâu phát; không phải secret và không đặt dưới domain khách.
NEXT_PUBLIC_PHIN_SDK_URL=https://phenau.com/phin.js
# Tên hiện trên tab + màn đăng nhập (tên khách, KHÔNG phải Phê Nâu)
NEXT_PUBLIC_BRAND_NAME=
# Màu nhấn
NEXT_PUBLIC_BRAND_ACCENT=#1F4470

# Bật 1 để chạy KHÔNG cần đăng nhập + dùng dữ liệu giả (chỉ dev)
NEXT_PUBLIC_MOCK=0

# ── Bật/tắt tính năng theo nhu cầu khách ──
# Nhập số tiền khi chốt đơn (chuyển sang 'Đã xong') (mặc định 1 = BẬT, đặt 0 = TẮT)
NEXT_PUBLIC_ENABLE_DEAL_REVENUE=1
# Hiển thị tab Báo cáo doanh thu & hiệu quả trên thanh điều hướng (mặc định 0 = TẮT, đặt 1 = BẬT)
NEXT_PUBLIC_ENABLE_INSIGHT_REPORT=0
