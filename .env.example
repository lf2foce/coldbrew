# ── Chép thành .env.local để chạy dev, hoặc set trên Vercel cho từng khách ──

# Backend Phê Nâu (server-side, không lộ ra browser)
BACKEND_URL=https://phenau-v3.onrender.com

# Clerk — DÙNG CHUNG instance với dashboard chính (cùng pool user).
# Lấy 2 giá trị này từ frontend/.env.local của repo.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Theo từng khách ──
# Agent duy nhất mà app này hiển thị (bắt buộc — thiếu là hiện cả workspace)
NEXT_PUBLIC_AGENT_ID=
# Tên hiện trên tab + màn đăng nhập (tên khách, KHÔNG phải Phê Nâu)
NEXT_PUBLIC_BRAND_NAME=
# Màu nhấn
NEXT_PUBLIC_BRAND_ACCENT=#1F4470

# Bật 1 để chạy KHÔNG cần Clerk + dùng dữ liệu giả (chỉ dev)
NEXT_PUBLIC_MOCK=0
# Workspace chứa agent — BẮT BUỘC nếu tài khoản thuộc nhiều workspace
NEXT_PUBLIC_TENANT_ID=
